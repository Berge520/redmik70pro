<?xml version="1.0" encoding="utf-8"?>
<!-- 极简布局：两行按钮 + 提示 + 可滚动的等宽日志，无第三方依赖 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        android:gravity="bottom">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 版本号在运行时由 MainActivity.readVersion() 从 PackageManager 读取后填入，
             见该方法注释；这里留空占位，避免把版本号硬编码进布局。 -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- 更新时机提示条：由 MainActivity.refreshSafetyBanner() 在启动/执行前刷新。
         本机激活态装 APK 会打穿 swap 导致整机重启，这条横幅就是唯一的事前拦阻手段。 -->
    <TextView
        android:id="@+id/tvSafety"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFix"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_fix"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_check"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_save"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:enabled="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRunning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/running_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:background="#11000000"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="@string/hint"
        android:textSize="12sp" />

    <!-- 项目仓库：点击直接跳浏览器。内容由 MainActivity 从 strings 填入，
         不硬编码在布局里，改地址只改一处。 -->
    <TextView
        android:id="@+id/tvRepo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:textColor="#1565C0"
        android:clickable="true"
        android:focusable="true" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A000000">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
